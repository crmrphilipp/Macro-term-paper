# SOURCE 2 : WorldBank, GDP PPP constant 2021 US-Dollar 
# ═════════════════════════════════════════════════════════════════════════════════

wb_gdp_url  <- "https://api.worldbank.org/v2/en/indicator/NY.GDP.MKTP.PP.KD?downloadformat=excel"
wb_file_gdp <- "../data/wb_data_gdp.csv"

dir.create("../data", showWarnings = FALSE)

if (!file.exists(wb_file_gdp)) {
  download.file(wb_gdp_url, destfile = wb_file_gdp, mode = "wb")
  message("wb_gdp dataset downloaded.")
}
 
# Load the main data sheet 
wb_gdp_raw <- read_excel(wb_file_gdp, skip = 2)

#investigate data structure
head(wb_gdp_raw)

# Clean data to form a working dataset

#wb_gdp_raw <- wb_gdp_raw %>%
  #filter(TIME_PERIOD >= 1990)

wb_gdp_raw <- wb_gdp_raw %>%
  filter(`Country Name` %in% oecd_countries)

library(dplyr)
library(tidyr)

wb_gdp_long <- wb_gdp_raw %>%
  pivot_longer(
    cols = matches("^\\d{4}$"),
    names_to = "year",
    values_to = "value"
  ) %>%
  mutate(
    year = as.integer(year)
  )


# ══════════════════════════════════════════════════════════════════════════════
# SOURCE 2 : WorldBank, GNI PPP constant 2021 US-Dollar 
# ═════════════════════════════════════════════════════════════════════════════════

wb_gni_url  <- "https://api.worldbank.org/v2/en/indicator/NY.GNP.MKTP.PP.KD?downloadformat=excel"
wb_file_gni <- "../data/wb_data_gni.csv"

dir.create("../data", showWarnings = FALSE)

if (!file.exists(wb_file_gni)) {
  download.file(wb_gni_url, destfile = wb_file_gni, mode = "wb")
  message("wb_gni dataset downloaded.")
}
 
# Load the main data sheet 
wb_gni_raw <- read_excel(wb_file_gni, skip = 2)

#investigate data structure
head(wb_gni_raw)

# Clean data to form a working dataset

#wb_gdp_raw <- wb_gdp_raw %>%
  #filter(TIME_PERIOD >= 1990)

wb_gni_raw <- wb_gni_raw %>%
  filter(`Country Name` %in% oecd_countries)

wb_gni_long <- wb_gni_raw %>%
  pivot_longer(
    cols = matches("^\\d{4}$"),
    names_to = "year",
    values_to = "value"
  ) %>%
  mutate(
    year = as.integer(year)
  )


# ══════════════════════════════════════════════════════════════════════════════
# Beide Datensetze mergen
# ═════════════════════════════════════════════════════════════════════════════════


gni_long_clean <- wb_gni_long %>%
  select(`Country Code`, `Country Name`, year, gni = value)

gdp_long_clean <- wb_gdp_long %>%
  select(`Country Code`, `Country Name`, year, gdp = value)

wb <- gni_long_clean %>%
  left_join(
    gdp_long_clean %>% select(`Country Code`, year, gdp),
    by = c("Country Code", "year")
  )

  wb <- wb %>%
  filter(year >= 1990)

  wb <- wb %>%
  rename(iso = `Country Code`)

# ══════════════════════════════════════════════════════════════════════════════
# SOURCE 2 : OECD / Population values 
# 
# Provides: Provides population values to compute per capita values
# NOTE: 
# ═════════════════════════════════════════════════════════════════════════════════


oecd_url_pop  <- "https://sdmx.oecd.org/public/rest/data/OECD.SDD.NAD,DSD_NAMAIN10@DF_TABLE3_POP_EMPNC,2.0/A.AUS+AUT+BEL+CAN+CHL+COL+CRI+CZE+DNK+EST+FIN+FRA+DEU+GRC+HUN+ISL+IRL+ISR+ITA+JPN+KOR+LVA+LTU+LUX+MEX+NLD+NZL+NOR+POL+PRT+SVK+SVN+ESP+SWE+CHE+TUR+GBR+USA...POP.......?startPeriod=1988&endPeriod=2025&dimensionAtObservation=AllDimensions&format=csvfilewithlabels"
oecd_file_pop <- "../data/oecd_data_pop.csv"

dir.create("../data", showWarnings = FALSE)

if (!file.exists(oecd_file_pop)) {
  download.file(oecd_url_pop, destfile = oecd_file_pop, mode = "wb")
  message("oecd_pop dataset downloaded.")
}
 
# Load the main data sheet 
oecd_pop_raw <- read_csv(oecd_file_pop)

#investigate data structure
head(oecd_pop_raw)

# Clean data to form a working dataset

oecd_pop_raw <- oecd_pop_raw %>%
  filter(TIME_PERIOD >= 1990)

oecd_pop_raw <- oecd_pop_raw %>%
  filter(`Reference area` %in% oecd_countries)

oecd_pop_raw_wide <- oecd_pop_raw %>%
  pivot_wider(
    id_cols = c(`REF_AREA`, TIME_PERIOD),
    names_from = Transaction,
    values_from = OBS_VALUE
  )

  oecd_pop_raw_wide <- oecd_pop_raw_wide %>%
  rename(iso = `REF_AREA`)

  oecd_pop_raw_wide <- oecd_pop_raw_wide %>%
  rename(year = `TIME_PERIOD`)

wb_oecd_df <- wb %>%
  left_join(
    oecd_pop_raw_wide %>% 
      select(iso, year, population = `Total population`),
    by = c("iso" = "iso", "year" = "year")
  )

wb_oecd_df <- wb_oecd_df %>%
  mutate(
    gdppc = gdp / (population * 1000),
    gnipc = gni / (population * 1000)
  )

####### deviations created


# per capita growth rates
wb_oecd_df <- wb_oecd_df %>%
  arrange(iso, year) %>%
  group_by(iso) %>%
  mutate(gdp_log_diff = log(gdppc) - log(lag(gdppc)),
    gni_log_diff = log(gnipc) - log(lag(gnipc))
    ) %>%
  ungroup()


# aggregate p.c. growht rates
wb_oecd_aggregate <- wb_oecd_df %>%
  group_by(year) %>%
  summarise(
    gdp_real_total = sum(gdp, na.rm = TRUE),
    pop_total      = sum(population * 1000, na.rm = TRUE),
    gni_real_total = sum(gni, na.rm = TRUE),
  ) %>%
  mutate(
    gdp_log_diff_total = log(gdp_real_total) - log(lag(gdp_real_total)),
    gni_log_diff_total = log(gni_real_total) - log(lag(gni_real_total))
  )

# join the aggregate growth rates
wb_oecd_df <- wb_oecd_df %>%
  left_join(wb_oecd_aggregate %>% select(year, gdp_log_diff_total, gni_log_diff_total), 
            by = "year")
  

# growth rate deviation
wb_oecd_df <- wb_oecd_df %>%
  mutate(gdp_dev = gdp_log_diff - gdp_log_diff_total)%>%
  mutate(gni_dev = gni_log_diff - gni_log_diff_total)


# regression data export
oecd_small_reg <- wb_oecd_df%>%
  select(iso, year, gdp_dev, gni_dev)

write_csv(oecd_small_reg, "../data/oecd_small_reg.csv")

